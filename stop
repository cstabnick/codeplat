#!/usr/bin/env bash
# stop stops what ./start started, from any terminal.
set -uo pipefail

run="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.run"

alive() { kill -0 "$1" 2>/dev/null; }

if [[ -f "$run/start.pid" ]] && alive "$(cat "$run/start.pid")"; then
  pid="$(cat "$run/start.pid")"
  echo "stopping ./start (pid $pid)..."
  kill -TERM "$pid"
  # ./start gives its services 15 seconds to stop, then kills them.
  for _ in $(seq 40); do alive "$pid" || break; sleep 0.5; done
fi

# ./start was killed without cleaning up: stop its services directly.
if [[ -f "$run/groups" ]]; then
  mapfile -t groups <"$run/groups"
  left=()
  for g in "${groups[@]}"; do kill -0 -- "-$g" 2>/dev/null && left+=("$g"); done
  if ((${#left[@]})); then
    echo "stopping ${#left[@]} leftover service group(s)..."
    for g in "${left[@]}"; do kill -TERM -- "-$g" 2>/dev/null; done
    for _ in $(seq 30); do
      any=0; for g in "${left[@]}"; do kill -0 -- "-$g" 2>/dev/null && any=1; done
      ((any)) || break; sleep 0.5
    done
    for g in "${left[@]}"; do kill -KILL -- "-$g" 2>/dev/null; done
  fi
fi

rm -f "$run/start.pid" "$run/groups"
echo "stopped"
